# Copy placeholders into Vercel Environment Variables. Never commit real secrets.
DATABASE_URL=postgresql://YOUR_NEON_CONNECTION_STRING
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_WEBHOOK_SECRET
# Generate a long random value; send it as Authorization: Bearer <value> to the maintenance endpoint.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Generate a separate random value of at least 32 characters for the private admin dashboard.
ADMIN_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
